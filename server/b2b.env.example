# PRIVATE SERVER CONFIGURATION ONLY. Never VITE_*, never tracked real values.
# Node.js 22.18.0 verified target. All activation flags stay false until owner-approved deployment checks.
B2B_ENQUIRIES_ENABLED=false
B2B_RUNTIME_VERIFIED=false
B2B_STORAGE_VERIFIED=false
B2B_PRIVACY_APPROVED=false
B2B_DELIVERY_ENABLED=false
B2B_PROXY_VERIFIED=false
# direct = verified HTTPS socket; trusted = exact proxy overwrites single client/proto headers.
B2B_PROXY_MODE=
B2B_TRUSTED_PROXY_IPS=
B2B_MYSQL_HOST=
B2B_MYSQL_PORT=3306
B2B_MYSQL_DATABASE=
B2B_MYSQL_USER=
B2B_MYSQL_PASSWORD=
# TCP requires verified TLS; alternatively a verified local Unix socket, never plaintext TCP.
# TCP requires explicit owner-approved DNS identity and verified TLS evidence.
B2B_MYSQL_TLS_SERVERNAME=
B2B_MYSQL_TLS_IDENTITY_AUTHORISED=false
B2B_MYSQL_TLS_RUNTIME_VERIFIED=false
B2B_MYSQL_TLS_TRUST_STORE=owner-ca-pem
B2B_MYSQL_TLS_CA=
B2B_MYSQL_SOCKET=
B2B_STORAGE_SECRET=
B2B_CRON_TOKEN=
B2B_CRON_URL=https://seedtrade.eu/api/internal/network-delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=network@seedtrade.eu
# PROPOSED ONLY; collection requires owner privacy approval. No deletion scheduler enabled.
B2B_RETENTION_DAYS=90
B2B_IDEMPOTENCY_DAYS=7
B2B_ABUSE_HOURS=24
B2B_RETENTION_DELETION_APPROVED=false
# Operational policies, not automatic deletion: logs 30d; backups 30d.
