# Registration only. Do not replace the historical enquiries configuration.
# Private server configuration; no actual secrets, no VITE_* variables.
SEEDTRADE_RUNTIME_ENV=staging
SEEDTRADE_PUBLIC_ORIGIN=https://staging.seedtrade.eu
SEEDTRADE_MAIL_TRANSPORT=test-stream
B2B_REGISTRATION_ENABLED=false
B2B_REGISTRATION_RUNTIME_VERIFIED=false
B2B_REGISTRATION_STORAGE_VERIFIED=false
B2B_REGISTRATION_MAIL_VERIFIED=false
B2B_REGISTRATION_PROXY_VERIFIED=false
B2B_REGISTRATION_PRIVACY_APPROVED=false
B2B_DB_HOST=127.0.0.1
B2B_DB_PORT=3306
B2B_DB_NAME=u230581718_staging_b2b
B2B_DB_USER=u230581718_b2b_stage
B2B_DB_PASSWORD=
# Reuse existing verified HTTPS proxy policy. Exact peers only, no arbitrary chains.
B2B_PROXY_MODE=
B2B_TRUSTED_PROXY_IPS=
# Only for the existing operator-run read-only probe; not an activation gate.
B2B_REGISTRATION_DB_PROBE=false
# Registration-only transport; changing this alone cannot activate registration.
B2B_REGISTRATION_MAIL_TRANSPORT=test-stream
# Customer login/profile/offer/inquiry endpoints require both flags plus all registration gates.
B2B_PORTAL_ENABLED=false
B2B_PORTAL_STORAGE_VERIFIED=false
# Privately approved, email-verified operator user IDs only; never self-assigned in registration.
B2B_PLATFORM_ADMIN_ENABLED=false
B2B_PLATFORM_ADMIN_USER_IDS=
# For separately approved SMTP acceptance only. The global transport stays test-stream.
# Use a provider-verified DNS host and sender; 465 implicit TLS or 587 required STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
