# STAGING ONLY. Configure privately; no actual secrets in this template.
SEEDTRADE_RUNTIME_ENV=staging
SEEDTRADE_PUBLIC_ORIGIN=https://staging.seedtrade.eu
SEEDTRADE_MAIL_TRANSPORT=test-stream
# Ordinary pages start with these disabled. Enquiries fail closed with HTTP503.
B2B_ENQUIRIES_ENABLED=false
B2B_RUNTIME_VERIFIED=false
B2B_STORAGE_VERIFIED=false
B2B_PRIVACY_APPROVED=false
B2B_PROXY_VERIFIED=false
B2B_PROXY_MODE=
B2B_TRUSTED_PROXY_IPS=
B2B_MYSQL_DATABASE=u230581718_seedtrade_test
B2B_MYSQL_USER=u230581718_st_test
B2B_MYSQL_PASSWORD=
B2B_MYSQL_HOST=localhost
B2B_MYSQL_PORT=3306
# Hostinger-authorised identity; real credential-free Package 3P TLS verification passed.
B2B_MYSQL_TLS_SERVERNAME=srv505.hstgr.io
B2B_MYSQL_TLS_IDENTITY_AUTHORISED=true
B2B_MYSQL_TLS_RUNTIME_VERIFIED=true
# Explicit native default roots. Do not set NODE_OPTIONS / NODE_EXTRA_CA_CERTS.
B2B_MYSQL_TLS_TRUST_STORE=node22-default
# owner-ca-pem alternative requires separately approved CA PEM, never a peer root.
B2B_MYSQL_TLS_CA=
B2B_MYSQL_SOCKET=
B2B_MYSQL_SOCKET_VERIFIED=false
B2B_STORAGE_SECRET=
B2B_STAGING_WORKER_ENABLED=false
B2B_CRON_TOKEN=
B2B_STAGING_TEST_EXECUTION=false
B2B_STAGING_REAL_TESTS=false
# Unapproved retention defaults; deletion inactive in staging runtime.
B2B_RETENTION_DAYS=90
B2B_IDEMPOTENCY_DAYS=7
B2B_ABUSE_HOURS=24
